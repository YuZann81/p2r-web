# ==============================================================================
# P2R Web Portal — Environment Reference (.env.example)
# ==============================================================================

# API Base URL (P2R Laravel API)
# Local development default:
NEXT_PUBLIC_P2R_API_BASE_URL=http://127.0.0.1:8090/p2r/v1

# Production reference:
# NEXT_PUBLIC_P2R_API_BASE_URL=https://api.razzan.site/p2r/v1

# P2R Admin Panel URL (for server-side proxies like game token)
# Local development default:
NEXT_PUBLIC_P2R_PANEL_URL=http://127.0.0.1:3001

# Production reference:
# NEXT_PUBLIC_P2R_PANEL_URL=https://p2r-panel.razzan.site
