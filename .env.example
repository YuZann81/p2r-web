# ==============================================================================
# P2R Web Portal - Environment Reference (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development (gitignored).
# Never put private API secrets in `NEXT_PUBLIC_*` variables.
#
# Routing contract:
#   /         public web (this application)
#   /panel    admin panel (p2r-panel)
#   /api/v1   public API
#             - Local dev: Next.js dev rewrite proxies /api/v1/* -> P2R_API_BASE_URL
#             - Staging/Production: Caddy proxies /api/v1/* -> Laravel /api/v1/*

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (`.env.local`)
# ------------------------------------------------------------------------------
# Single canonical server-side API base URL (used by SSR, route handlers,
# `/api/platform-status`, and the Next.js dev rewrite for `/api/v1/*`).
# Must be an explicit absolute http(s) URL:
#   - Local API (default): http://127.0.0.1:8091/api/v1
#   - Remote production API (read-only dev testing): https://pameran.devsaka.id/api/v1
P2R_API_BASE_URL=http://127.0.0.1:8091/api/v1

# Browser API base (optional override; defaults to same-origin `/api/v1`).
# Leave unset or set to `/api/v1` so browser requests go through the Next.js
# dev proxy (`next.config.mjs`) with zero CORS issues and no hardcoded origins.
# Only set an explicit local origin if bypassing the dev proxy:
# NEXT_PUBLIC_P2R_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. STAGING / VALIDATION (injected by staging runtime; do not uncomment locally)
# ------------------------------------------------------------------------------
# P2R_API_BASE_URL=http://127.0.0.1:8091/api/v1
# NEXT_PUBLIC_P2R_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 3. PRODUCTION RUNTIME (injected by host/Docker/Caddy; NEVER use for local dev)
# ------------------------------------------------------------------------------
# Authoritative production origin: https://pameran.devsaka.id
# P2R_API_BASE_URL=http://127.0.0.1:8090/api/v1
# NEXT_PUBLIC_P2R_API_BASE_URL=/api/v1
