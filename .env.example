# ==============================================================================
# P2R Web Portal - Environment Reference (.env.example)
# ==============================================================================
#
# Authoritative production origin:
#   https://pameran.devsaka.id
#
# Routing contract:
#   /       public web (this application)
#   /panel  admin panel (p2r-panel)
#   /api    public API (Caddy rewrites /api/* to Laravel /p2r/v1/*)
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time by
# `next build`. They must be absolute URLs that a browser can resolve.
# Non-NEXT_PUBLIC_ values are read by the Node server at RUNTIME and never
# appear in the browser bundle.

# ------------------------------------------------------------------------------
# Browser API base (BUILD time, public)
# ------------------------------------------------------------------------------
# Production (authoritative, supplied by .github/workflows/deploy.yml):
# NEXT_PUBLIC_P2R_API_BASE_URL=https://pameran.devsaka.id/api

# Local development:
NEXT_PUBLIC_P2R_API_BASE_URL=http://127.0.0.1:8090/p2r/v1

# ------------------------------------------------------------------------------
# Server-side API base (RUNTIME only, server)
# ------------------------------------------------------------------------------
# Read by lib/api/config.ts on the Node server (server components, ISR and
# route handlers). On the production host this is the Laravel app behind
# Nginx. Never prefix this with NEXT_PUBLIC_ and never set it at build time:
# it belongs in the p2r-web env block of ecosystem.config.js.
#
# Example runtime value (not loaded by this template):
# P2R_API_BASE_URL=http://127.0.0.1:8090/p2r/v1

# ------------------------------------------------------------------------------
# Admin Panel URL (BUILD time, public)
# ------------------------------------------------------------------------------
# Production (authoritative, supplied by .github/workflows/deploy.yml):
# NEXT_PUBLIC_P2R_PANEL_URL=https://pameran.devsaka.id/panel

# Local development:
NEXT_PUBLIC_P2R_PANEL_URL=http://127.0.0.1:3002
